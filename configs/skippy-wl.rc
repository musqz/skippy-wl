## skippy-wl config: copy to ~/.config/skippy-wl/skippy-wl.rc
## "key = value" lines grouped under [sections]. Read each time the overlay opens.
## Remove the leading # from an option to set it.

[layout]
## Pixels around the grid and between tiles.
#margin = 48
#spacing = 28

[tiles]
## Corner radius in pixels of each window preview and its frame (0-50). 0 = square.
#radius = 0

[label]
## Window name on each tile. Colors are #RRGGBB or #RRGGBBAA.
#show = true

## windowTitle, windowClass (the app id) or both.
#option = windowTitle

## below (under the tile), or inside it: top-left, top, top-right, left, center, right, bottom-left, bottom, bottom-right.
#position = below

## Move the label from its position; it may leave the tile.
#offsetX = 0
#offsetY = 0

## Box height in pixels (below also reserves it under the tile), width as a fraction of the tile, corner radius in pixels.
#height = 28
#width = 0.92
#radius = 6

## opacity (0-255) scales border and background. backgroundHighlight is for the selected tile; unset = background.
## With no background set, each label gets a dark fill and an outline in the color of its tile frame (highlight when selected, border otherwise).
#border = #00000000
#background = #00000000
#backgroundHighlight = #555555
#opacity = 255

#text = #ffffff
#textOutline = #00000000

## Pango description or skippy-xd style (Name:size=12:weight=bold). Also sets the filter bar font.
#font = Sans 11

[monitors]
## Windows per monitor: each (the ones on that monitor) or pointer (all of them on the monitor under the pointer).
#mode = each

[switch]
## Switch mode (--next/--prev): releasing the modifiers held when the overlay opened picks the selected window.
#pivot = true

## ms to wait before drawing; a tap shorter than that switches without drawing (0 = draw at once; needs pivot).
#wait = 100

## ms: releasing the modifiers this long after the overlay was drawn or the last key press leaves it open (0 = always pick).
#hold = 1000

[icons]
## App icon on each tile. Set theme to your icon theme: hicolor alone lacks many apps.
## size is in pixels (16-256); the theme's parents and hicolor are searched too.
#enabled = true
#size = 48
#theme = hicolor

## Where the icon sits on the tile: top-left, top, top-right, left, center, right, bottom-left, bottom, bottom-right.
## A label.position inside the tile at the same place overlaps it.
#position = bottom-right

[animation]
## Fade and grow when the overlay opens. duration is in ms (0-1000); 0 shows it at once.
#enabled = true
#duration = 150

[background]
## PNG, JPEG, AVIF, HEIC or HEIF image shown behind the tiles, scaled to fill each monitor. Unset = plain color.
## colors.background = #00000000 makes the overlay see-through: windows show behind the tiles.
#image = ~/Pictures/wallpaper.png

## Shell command that prints the image path, run each time the overlay opens. Falls back to image if it fails or takes over 1 s.
#image_cmd = noctalia msg wallpaper-get

## show: leave room for panels and docks that reserve space; the image is scaled to the smaller area and the panels stay clickable.
## hide: the overlay covers them.
#panels = hide

[colors]
## #RRGGBB or #RRGGBBAA. With an image, setting it tints the image; leave it unset for the image alone.
#background = #000000ff
#highlight = #5999ff
#border = #ffffff2e

## Labwc theme file to take the highlight and border colors from (only a leading ~/ is expanded).
## Tile borders from the theme use 60% alpha. highlight and border above win.
#theme_file = ~/.local/share/themes/noctalia/openbox-3/themerc

[hide]
## Windows whose app id, title or status matches are never shown, in --switch either. Comma separated globs, same syntax as --app-id and --title.
#app_id = org.keepassxc.KeePassXC
#title = Picture-in-Picture
## minimized, maximized, fullscreen or activated.
#status = minimized

[bind]
## xkb keysym names, comma separated. A line replaces the default keys of that action.
#select = Return, KP_Enter
#cancel = Escape
#close = Delete
#minimize = m, M
#left = Left
#right = Right
#up = Up
#down = Down
#home = Home
#end = End
#next = Tab
#prev = ISO_Left_Tab
