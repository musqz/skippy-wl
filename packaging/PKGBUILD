# Maintainer: musqz <gummy-fang-deputy@duck.com>
# Local build from this checkout (committed HEAD): cd packaging && makepkg -f
pkgname=skippy-wl-git
pkgver=0.1.0.r82.g558d411
pkgrel=1
pkgdesc='Window overview for labwc'
arch=('x86_64')
url='https://github.com/musqz/skippy-wl'
license=('GPL-3.0-or-later')
depends=('cairo' 'gdk-pixbuf2' 'glib2' 'libheif' 'libxkbcommon' 'pango' 'librsvg' 'wayland')
makedepends=('git' 'meson')
provides=('skippy-wl')
conflicts=('skippy-wl')
source=("$pkgname::git+file://$(dirname "$PWD")")
sha256sums=('SKIP')

pkgver() {
	cd "$pkgname"
	printf '%s.r%s.g%s' "$(sed -n "s/^  version: '\(.*\)',/\1/p" meson.build)" \
		"$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	arch-meson "$pkgname" build
	meson compile -C build
}

check() {
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
